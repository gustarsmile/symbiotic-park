  "labels": [
    {
      "key": "beds",
      "name": "葉菜畦",
      "x": 556,
      "y": 1004,
      "about": {
        "text": "每週都收的葉菜。種多少，先看訂戶要多少再回推。最外圈那一畦剛種下去，是下一輪的。",
        "source": "運作設計 6.2（一）"
      }
    },
    {
      "key": "herb",
      "name": "香草園",
      "x": 318,
      "y": 968,
      "about": {
        "text": "香茅、薄荷、紫蘇、九層塔、洛神、薑黃。新鮮的附在菜箱，其餘曬乾做茶。",
        "source": "產品線規劃 2.4；產品線規劃 一"
      }
    },
    {
      "key": "shed",
      "name": "集貨棚",
      "x": 256,
      "y": 700,
      "about": {
        "text": "剛收的菜在這裡分級、裝箱。北邊是曬場。",
        "source": "產品線規劃 一；運作設計 13.4"
      }
    },
    {
      "key": "yard",
      "name": "曬場",
      "x": 193,
      "y": 540,
      "about": {
        "text": "洛神、菜乾和香草在這裡曬。乾到什麼程度才能收，每一種都訂出標準、留下紀錄。",
        "source": "產品線規劃 4.1；產品線規劃 4.5"
      }
    },
    {
      "key": "compost",
      "name": "堆肥區",
      "x": 196,
      "y": 838,
      "about": {
        "text": "廚餘和菜葉在這裡變成肥料，回到田裡。",
        "source": "運作設計 6.2（二）"
      }
    },
    {
      "key": "work",
      "name": "加工坊",
      "x": 325,
      "y": 212,
      "about": {
        "text": "先從最簡單的乾燥做起，再做冷藏冷凍，最後才是醬料。",
        "source": "產品線規劃 一"
      }
    },
    {
      "key": "shop",
      "name": "門市",
      "x": 650,
      "y": 91,
      "about": {
        "text": "每樣東西都標出「每 100 元去哪裡」。",
        "source": "運作設計 6.3 規則四"
      }
    },
    {
      "key": "office",
      "name": "辦公室",
      "x": 975,
      "y": 212,
      "about": {
        "text": "帳務和開會的地方。關於人的決定，一律由人決定，電腦只提供資料。",
        "source": "運作設計 6.8"
      }
    },
    {
      "key": "board",
      "name": "帳本公開牆",
      "x": 896,
      "y": 402,
      "about": {
        "text": "每個月的帳貼在這裡，誰都可以看。",
        "source": "運作設計 6.9"
      }
    },
    {
      "key": "dining",
      "name": "共食餐廳・共學教室",
      "x": 1090,
      "y": 426,
      "about": {
        "text": "白天是教室：導師在黑板前給孩子和志工上課。傍晚收起課本開飯，每週一次的晚餐誰都可以來。起步時不另外蓋教室。",
        "source": "運作設計 6.7；運作設計 13.5；運作設計 6.4；口頭決定 2026-11-20"
      }
    },
    {
      "key": "green",
      "name": "溫網室",
      "x": 985,
      "y": 922,
      "about": {
        "text": "育苗的地方。賣菜的錢先留一份買種苗，下一輪才接得上。",
        "source": "運作設計 13.4；運作設計 6.2（一）"
      }
    },
    {
      "key": "park",
      "name": "休憩公園",
      "x": 650,
      "y": 478,
      "about": {
        "text": "留給大家休息、聊天、散步的地方。附近的鄰居也可以進來走走。",
        "source": "口頭決定 2026-11-20"
      }
    },
